{
  "name": "md-to-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把写给 AI 的长篇 markdown 渲染成一个 HTML 文件：能一口气读完，也能直接发给别人",
  "license": "MIT",
  "author": "crane <1030784773@qq.com>",
  "bin": {
    "md2html": "src/cli.mjs"
  },
  "scripts": {
    "render": "node src/cli.mjs",
    "test": "node test/determinism.mjs && node test/examples.mjs",
    "render:examples": "node src/cli.mjs examples/*.md --out out/examples --index",
    "test:examples": "node test/examples.mjs",
    "human:build": "node test/human/build.mjs",
    "human:serve": "node test/human/serve.mjs",
    "human:analyze": "node test/human/analyze.mjs",
    "shots": "node test/screenshots.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraneZhouGo/md-to-html.git"
  },
  "homepage": "https://github.com/CraneZhouGo/md-to-html#readme",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
